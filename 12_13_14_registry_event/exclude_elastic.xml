<Sysmon schemaversion="4.30">
  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="exclude">
        <Image condition="is">C:\Program Files\Elastic\Endpoint\elastic-endpoint.exe</Image> <!--Elastic Defend: very noisy CreateKey events-->
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
