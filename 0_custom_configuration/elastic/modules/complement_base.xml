<Sysmon schemaversion="4.90">
  <!--Switchboard of the Elastic Defend complement profile. It gives every event an explicit filter, because Sysmon does
      not document what it does with an event that has no filter, and a default installation logs events 1, 2, 5, and 6.
      The merger combines these filters with the modules that complement.txt selects, so each event ends up with one
      include filter and one exclude filter.
      Logged in full, minus the exclusions in complement.txt: events 2, 6, 8, 9, 17/18, 19-21, and 25. Do not select include
      modules for these events: a single include rule turns an event into an allow-list.
      Switched off unless complement.txt selects an include module: events 1, 3, 5, 7, 10-15, 22, 23, 24, 26, 27, 28,
      and 29. An include module logs only what its rules match.-->
  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreateTime onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessTerminate onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <DriverLoad onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <RawAccessRead onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreateStreamHash onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <PipeEvent onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileDelete onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ClipboardChange onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessTampering onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileDeleteDetected onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileBlockExecutable onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileBlockShredding onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileExecutableDetected onmatch="include"/>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
