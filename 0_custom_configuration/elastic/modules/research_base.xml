<Sysmon schemaversion="4.90">
  <!--Base of the Elastic Defend research profile: every event is logged, except FileDelete archiving (23) and
      the FileBlockExecutable and FileBlockShredding prevention events (27, 28).
      It starts from the repository's former sysmonconfig-research.xml (removed in 0cefc18), with these changes:
      - The powershell.exe RegistryEvent exclusion covers only CreateKey. The old exclusion hid every PowerShell registry change;
        in the October 7 test, CreateKey made 516,117 of PowerShell's 516,717 registry events, mostly certificate-store key opens.
      - No Splunk, Azure guest agent, Microsoft Monitoring Agent, or C:\Tools exclusions. None of those products ran in
        the lab, and a standard user can create C:\WindowsAzure\GuestAgent* or C:\Tools\Sysinternals\ where they don't exist.
      - Prevention is switched off with empty include filters, as in the Detection Lab derivative of that file.
      - FileExecutableDetected (29) is logged on Sysmon 15.
      The Elastic Agent and Elastic Defend exclusions, and the query-only process access exclusion, come from the modules
      listed in research.txt.-->
  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreateTime onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessTerminate onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <DriverLoad onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <RawAccessRead onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="exclude">
        <SourceImage condition="is">C:\windows\system32\csrss.exe</SourceImage>
        <SourceImage condition="is">C:\windows\system32\lsass.exe</SourceImage>
      </ProcessAccess>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="exclude">
        <Image condition="is">C:\windows\Sysmon64.exe</Image>
        <Rule groupRelation="and">
          <!--PowerShell opening registry keys, which Sysmon reports as CreateKey. Its value changes and deletions are still logged-->
          <Image condition="is">C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe</Image>
          <EventType condition="is">CreateKey</EventType>
        </Rule>
        <Rule groupRelation="and">
          <Image condition="is">C:\Windows\SysWOW64\WindowsPowerShell\v1.0\powershell.exe</Image>
          <EventType condition="is">CreateKey</EventType>
        </Rule>
      </RegistryEvent>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileCreateStreamHash onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <PipeEvent onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileDelete onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ClipboardChange onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <ProcessTampering onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileDeleteDetected onmatch="exclude"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileBlockExecutable onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileBlockShredding onmatch="include"/>
    </RuleGroup>
    <RuleGroup name="" groupRelation="or">
      <FileExecutableDetected onmatch="exclude"/>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
