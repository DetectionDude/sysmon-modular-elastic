<Sysmon schemaversion="4.30">
  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="include">
        <!--Every LSASS open, whatever the access mask. Sysmon compares GrantedAccess as text, so a list of read masks
            misses any mask it doesn't name, such as 0x101410 with SYNCHRONIZE. Pair it with
            10_process_access/exclude_query_only_access.xml, which drops the masks that can't read memory: 30,375 of the
            30,388 LSASS opens on the lab host. The other 13 were wmiprvse.exe with 0x1410-->
        <TargetImage name="technique_id=T1003.001,technique_name=LSASS Memory" condition="is">C:\Windows\System32\lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
