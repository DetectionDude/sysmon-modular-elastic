<Sysmon schemaversion="4.60">
  <EventFiltering>
    <RuleGroup name="technique_id=T1685,technique_name=Disable or Modify Tools" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <Rule groupRelation="and">
          <!--Files deleted from the Elastic Agent or Elastic Defend folders by anything other than Elastic itself-->
          <TargetFilename condition="begin with">C:\Program Files\Elastic\</TargetFilename>
          <Image condition="excludes">C:\Program Files\Elastic\</Image>
        </Rule>
      </FileDeleteDetected>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
