<Sysmon schemaversion="4.40">
  <EventFiltering>
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <Image condition="end with">winlogbeat.exe</Image> <!--Credit d4ph1l -->
        <Image condition="end with">packetbeat.exe</Image>
        <Image condition="is">C:\Program Files\Elastic\Endpoint\elastic-endpoint.exe</Image> <!--Elastic Defend-->
        <Rule groupRelation="and">
          <Image condition="begin with">C:\Program Files\Elastic\Agent\data\elastic-agent-</Image>
          <Image condition="end with">\components\elastic-otel-collector.exe</Image>
        </Rule>
      </NetworkConnect>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
